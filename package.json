{
  "name": "safego-school-bus-system",
  "version": "1.0.0",
  "description": "School Bus Seat Reservation System",
  "main": "index.js",
  "scripts": {
    "install-all": "cd backend && npm install && cd ../frontend && npm install && cd ../admin-dashboard/admin-dashboard && npm install",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:admin\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "start:admin": "cd admin-dashboard/admin-dashboard && npm run dev",
    "dev": "npm run start",
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "cd frontend && npm run build",
    "build:admin": "cd admin-dashboard/admin-dashboard && npm run build"
  },
  "keywords": [
    "school",
    "bus",
    "reservation",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "SafeGo Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}